@model List<Product>
<div>
    <h1>Products</h1>
    <a class="btn btn-primary" asp-controller="Product" asp-action="Create">Add Product</a>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Name</th>
                <th scope="col">Price</th>
                <th scope="col">Description</th>
                <th scope="col">Category</th>
                <th scope="col">Image</th>
                <th scope="col">Status</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Product product in Model)
            {
                <tr>
                    <th scope="row">@product.Id</th>
                    <td>@product.Name</td>
                    <td>@product.Price</td>
                    <td>@product.Description</td>
                    <td>@product.Category.Name</td>
                    <td>
                        <img height="50px" width="50px" src="~/uploads/products/@product.ImageUrl"/>
                    </td>
                    <td>
                        @if (!product.IsDeleted)
                        {
                            <p class="text-success">Active</p>
                        }
                        else
                        {
                            <p class="text-danger">Inactive</p>

                        }
                    </td>
                    <td>
                        <a class="btn btn-warning" asp-controller="Product" asp-action="Update" asp-route-id="@product.Id">Update</a>
                    </td>
                    <td>
                        @if (!product.IsDeleted)
                        {
                            <form asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id" method="post">
                                <button class="btn btn-danger">Delete</button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Product" asp-action="Restore" asp-route-id="@product.Id" method="post">
                                <button class="btn btn-success">Restore</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>